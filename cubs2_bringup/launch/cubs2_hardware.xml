<?xml version="1.0"?>
<!--
  cubs2_hw.launch.xml

  Hardware flight-stack launch for the Sport Cub S 2.

  Composition:
    - joy_node (manual transmitter input)
    - topic_tools throttles for manual + auto control streams
    - cubs2_control  (autopilot, publishes AircraftControl on /control_auto)
    - cubs2_planner  (mission/guidance layer)
    - cubs2_ppm_bridge (serial-to-Arduino PPM driver)
    - rviz2 with cubs2_bringup/config/cubs2_hw.rviz (optional)

  Usage:
    ros2 launch cubs2_bringup cubs2_hw.launch.xml
    ros2 launch cubs2_bringup cubs2_hw.launch.xml vehicle:=cub1 controller:=taranis rviz:=true
-->
<launch>

  <!-- ========== Launch arguments ========== -->
  <arg name="sim"        default="false"    description="use simulated clock"/>
  <arg name="rviz"       default="false"    description="launch rviz2 with cubs2_hw.rviz config"/> 
  <!-- TODO: Add rviz config for hardware mode -->
  <arg name="joy"        default="true"     description="launch joystick node for manual control"/>
  <arg name="controller" default="taranis"  description="transmitter type: taranis | f310 | ps4"/>
  <arg name="log_level"  default="warn"     description="ROS logging level"/>
  <arg name="vehicle"    default="cub1"     description="vehicle id, used as ROS namespace"/>

  <group>
    <push-ros-namespace namespace="$(var vehicle)"/>

    <!-- ==== Manual input ==== -->
    <node pkg="joy" exec="joy_node" name="control_manual"
          output="log" if="$(var joy)"
          on_exit="shutdown">
      <param name="use_sim_time"        value="$(var sim)"/>
      <param name="coalesce_interval_ms" value="1"/>
      <param name="autorepeat_rate"      value="20.0"/>
      <param name="deadzone"             value="0.02"/>
      <remap from="joy" to="control_manual"/>
    </node>

    <!-- ==== Topic throttles ==== -->
    <!-- Manual: /control_manual -> /control_manual_throttle (10 Hz) -->
    <node_container name="joy_thr" pkg="rclcpp_components" exec="component_container" output="both">
      <composable_node pkg="topic_tools" plugin="topic_tools::ThrottleNode" name="joy_throttle">
        <param name="throttle_type" value="messages"/>
        <param name="input_topic"   value="control_manual"/>
        <param name="msgs_per_sec"  value="10.0"/>
        <extra_arg name="use_intra_process_comms" value="true"/>
      </composable_node>
    </node_container>

    <!-- Auto: /control_auto -> /control_auto_throttle (10 Hz) -->
    <node_container name="auto_joy_thr" pkg="rclcpp_components" exec="component_container" output="both">
      <composable_node pkg="topic_tools" plugin="topic_tools::ThrottleNode" name="throttle">
        <param name="throttle_type" value="messages"/>
        <param name="input_topic"   value="control_auto"/>
        <param name="msgs_per_sec"  value="10.0"/>
        <extra_arg name="use_intra_process_comms" value="true"/>
      </composable_node>
    </node_container>

    <!-- ==== Autopilot stack ==== -->
    <node pkg="cubs2_planner" exec="cubs2_planner_node" name="planner"
          output="log" on_exit="shutdown">
      <param name="use_sim_time" value="$(var sim)"/>
      <param name="vehicle_id"   value="$(var vehicle)"/>
    </node>

    <node pkg="cubs2_control" exec="cubs2_control_node" name="control"
          output="log" on_exit="shutdown">
      <param name="use_sim_time" value="$(var sim)"/>
      <param name="vehicle_id"   value="$(var vehicle)"/>
    </node>

    <!-- ==== Hardware bridge ==== -->
    <node pkg="cubs2_ppm_bridge" exec="node4ch" name="bridge"
          output="log" on_exit="shutdown">
      <param name="use_sim_time"         value="$(var sim)"/>
      <param name="coalesce_interval_ms" value="50"/>
      <param name="autorepeat_rate"      value="20.0"/>
      <param name="deadzone"             value="0.02"/>
      <param name="controller_id"        value="$(var controller)"/>
      <param name="vehicle_id"           value="$(var vehicle)"/>
      <remap from="joy_throttle"      to="control_manual_throttle"/>
      <remap from="auto_joy_throttle" to="control_auto_throttle"/>
    </node>

    <!-- ==== Visualization ==== -->
    <node pkg="rviz2" exec="rviz2" name="rviz2"
          output="screen" if="$(var rviz)"
          args="-d $(find-pkg-share cubs2_bringup)/config/cubs2_hw.rviz"
          on_exit="shutdown">
      <param name="use_sim_time" value="$(var sim)"/>
    </node>

  </group>

</launch>